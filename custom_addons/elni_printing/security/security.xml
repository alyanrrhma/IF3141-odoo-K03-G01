<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_elni" model="ir.module.category">
        <field name="name">PT ELNI</field>
        <field name="sequence">100</field>
    </record>

    <!-- Group dasar: semua peran mewarisinya. Pelanggan portal TIDAK termasuk. -->
    <record id="group_elni_user" model="res.groups">
        <field name="name">Pengguna ELNI (dasar)</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_sales" model="res.groups">
        <field name="name">Sales, CSO &amp; GA</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_designer" model="res.groups">
        <field name="name">Designer</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_qa" model="res.groups">
        <field name="name">Quality Assurance</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_logistik" model="res.groups">
        <field name="name">Logistik &amp; Pembelian</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_finance_ar" model="res.groups">
        <field name="name">Keuangan: A/R Staff</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_finance_manager" model="res.groups">
        <field name="name">Keuangan: Manager Keuangan</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_accounting" model="res.groups">
        <field name="name">Keuangan: Chief Akunting</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_management" model="res.groups">
        <field name="name">Manajemen</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_elni_it" model="res.groups">
        <field name="name">IT &amp; Tech</field>
        <field name="category_id" ref="module_category_elni"/>
        <field name="implied_ids" eval="[(4, ref('group_elni_user')), (4, ref('base.group_erp_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rule portal: pelanggan hanya melihat pesanan miliknya (dan perusahaannya). -->
    <record id="rule_portal_order" model="ir.rule">
        <field name="name">ELNI Pesanan: portal hanya milik sendiri</field>
        <field name="model_id" ref="model_elni_order"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_portal_order_line" model="ir.rule">
        <field name="name">ELNI Baris Pesanan: portal</field>
        <field name="model_id" ref="model_elni_order_line"/>
        <field name="domain_force">[('order_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_portal_preview" model="ir.rule">
        <field name="name">ELNI Preview: portal</field>
        <field name="model_id" ref="model_elni_design_preview"/>
        <field name="domain_force">[('order_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_portal_product" model="ir.rule">
        <field name="name">ELNI Produk: portal hanya produk cetak</field>
        <field name="model_id" ref="model_elni_product"/>
        <field name="domain_force">[('kind', '=', 'print')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
